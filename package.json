    "@radix-ui/react-icons": "1.3.2",
    "@types/leaflet": "^1.9.22",
    "@use-gesture/react": "10.3.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "motion": "12.42.2",
